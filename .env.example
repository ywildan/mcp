# Copy to .env and edit. Nothing here is a usable default: you MUST set the passwords/secrets.
PUBLIC_URL=https://relay.example.com
DOMAIN=relay.example.com
POSTGRES_PASSWORD=change-me-db
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-bootstrap-only   # only used to create the first admin when the DB has no users
SESSION_SECRET=generate-with-openssl-rand-hex-32
# Email signup verification (Resend). RESEND_API_KEY is required for the signup flow: copy it from
# https://resend.com/api-keys (Resend dashboard). EMAIL_FROM must use the domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="AgentRelay <admin@helux.web.id>"
# Optional tuning (defaults shown)
WAIT_DEFAULT_SECONDS=0          # 0 = infinite
WAIT_CHUNK_SECONDS=30
WAIT_KEEPALIVE_SECONDS=15
WAIT_INFINITE_MAX_SECONDS=3600
MAX_ACTIVE_WAITS=500
INBOX_LEASE_SECONDS=120
HOP_LIMIT_DEFAULT=20
RATE_LIMIT_MSG_PER_MIN=60
RATE_LIMIT_CALLS_PER_MIN=600
RETENTION_DAYS_MESSAGES=90
LOG_LEVEL=info
# Email verification tuning (defaults shown)
VERIFY_CODE_TTL_SECONDS=600        # code lifetime (10 minutes)
VERIFY_CODE_MAX_ATTEMPTS=5         # wrong code attempts before a code is dead
VERIFY_RESEND_COOLDOWN_SECONDS=60  # "resend code" cooldown per email
VERIFY_REQUESTS_PER_HOUR=5         # code requests per email and per IP per hour
